@startuml
title Flowchart — СМО расчёта стоимости и условий доставки

skinparam backgroundColor white
skinparam shadowing false

skinparam activity {
    BackgroundColor #EAF3FF
    BorderColor #4778A8
    DiamondBackgroundColor #FFF2D5
    DiamondBorderColor #B78B37
    ArrowColor #555555
    FontSize 13
}

|Источники заявок (1..N)|
start

fork
    |Источники заявок (1..N)|

    repeat
        :Сгенерировать интервал поступления;
        :Ожидать интервал;
        :Создать заявку;
        :Уведомить ДП о новой заявке;

        backward :Повторить генерацию;
    repeat while (Продолжать генерацию заявок?) is (Да)
    ->Нет;

fork again

    |ДП|

    repeat
        :Ожидать уведомления от источника;
        :Получить уведомление;
        :Запросить заявку у источника;

        |Источники заявок (1..N)|
        :Передать заявку ДП;

        |ДП|
        :Получить заявку;
        :Направить заявку в буфер;

        backward :Ожидать следующую заявку;
    repeat while (Продолжать работу ДП?) is (Да)
    ->Нет;

fork again

    |Буфер|

    repeat
        :Получить заявку от ДП;

        if (Буфер заполнен?) then (Да)
            :Вытеснить заявку под указателем;
            :Зафиксировать отказ;
            :Разместить новую заявку;
        else (Нет)
            :Разместить заявку
            в свободной ячейке;
        endif

        :Уведомить ДВ о наличии заявки;

    repeat while (Продолжать работу буфера?) is (Да)
    ->Нет;

fork again

    |ДВ|

    repeat
        :Ожидать уведомления
        от буфера или прибора;

        if (Есть заявки в буфере?) then (Да)

            if (Есть свободные приборы?) then (Да)

                :Выбрать свободный прибор
                по приоритету Д2П1;

                |Приборы (1..M)|
                :Назначить выбранный прибор;

                |Буфер|
                :Извлечь заявку по Д2Б1;

                |ДВ|
                :Передать заявку выбранному прибору;

            endif
        endif

        |ДВ|

    repeat while (Продолжать работу ДВ?) is (Да)
    ->Нет;

fork again

    |Приборы (1..M)|

    repeat
        :Ожидать назначения заявки от ДВ;
        :Принять заявку;
        :Перейти в состояние "Занят";

        :Рассчитать стоимость
        и условия доставки;

        :Завершить обслуживание;
        :Перейти в состояние "Свободен";
        :Уведомить ДВ об освобождении;

    repeat while (Продолжать работу приборов?) is (Да)
    ->Нет;

end fork

stop
@enduml